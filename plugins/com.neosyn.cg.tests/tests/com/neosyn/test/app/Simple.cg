package com.neosyn.test.app.basics;

// A NETWORK carrying a vector test -- which does work, contrary to a long-standing note
// that `test: {port: [...]}` is task-only. It had been elaborate-only because a pipelined
// network could not DRAIN: the stimulus stopped dead after the last vector, so stage_2
// never saw stage_1's final (registered) output and the run hung one vector short. The
// stimulus now holds its last value with valid asserted; see TestGenerator.
network Pipeline {

	properties {
		// res[i] = (a[i] + b[i]) * c[i]
		test: {
			a:   [ 1,  2,  3,  4 ],
			b:   [ 2,  3,  4,  5 ],
			c:   [ 3,  3,  3,  3 ],
			res: [ 9, 15, 21, 27 ]
		}
	}

	in sync u8 a, sync b, sync c; out sync u17 res;

	stage_1 = new task {
		out sync u9 res;
		void loop() {
			res.write(a.read + b.read); 
		}
	};

	stage_2 = new task {
		void loop() {
			res.write(stage_1.res.read * c.read); 
		}
	};

}

bundle Definitions {
	typedef u9 count_t;
	typedef u6 clipped;
}

// Left WITHOUT a vector test, deliberately, and the reason is worth recording (S166).
//
// The validator requires test values for EVERY output once a `test:` block exists
// ("missing test values for port OutData"), so checking `digits` alone is not an option.
// `digits` itself is easy and was verified working: 0x01FF while count < 100, then
// 0x4FFF, the change landing one index late because digits lags count by a cycle. A
// 103-entry vector across that boundary passes, and would prove the counter advances
// rather than merely sitting at a constant.
//
// `OutData` is the blocker. Compare's result is `temp == clip.O`, where `temp` is the
// count read at the end of the PREVIOUS iteration and clip.O is min(count, 63) from its
// own stage, after a setup() that idles one cycle. The shape is derivable -- equal while
// count <= 63, diverging once clipping starts -- but the observed sequence starts FALSE,
// so the fill does not match that shape, and recovering the true alignment would mean
// probing one index at a time. A vector obtained that way pins the implementation against
// itself and proves nothing, so it is not written here.
//
// Deriving Compare's alignment is the prerequisite, not more scaffolding.
network TopCounter {

	out bool OutData, u15 digits;

	counter = new task {
		out Definitions.count_t count;

		Definitions.count_t count_i;

		void loop() { // 9-bit wrap-around counter.
			count.write(count_i);
			count_i++;
		}
	};

	clip = new task {
		out Definitions.clipped O;

		void loop() {
			Definitions.count_t local = counter.count.read();
			O.write(local > 63 ? 63 : (u6) local);
		}
	};

	digit = new task {
		void loop() { // Manages the 15-segments display of the Versa board.
			Definitions.count_t count = counter.count.read;
			u15 tmp;
			if (count < 100) {
				tmp = 0x01FF;
			} else if (count < 200) {
				tmp = 0x4FFF;
			} else if (count < 300) {
				tmp = 0x13DD;
			} else if (count < 400) {
				tmp = 0x07DD;
			} else if (count < 500) {
				tmp = 0x4DDD;
			} else if (count < 511) {
				tmp = 0x25DD;
			} else {
				tmp = 0x7EAB;
			}
			digits.write(tmp);
		}
	};

	compare = new Compare();
	compare.reads(clip.O, counter.count);
	compare.writes(OutData);
}

task Compare {
	import com.neosyn.test.app.basics.Definitions.*;

	in clipped clip, count_t count; out bool result;

	count_t temp;

	void setup() {
		// reads from "count" in the second cycle
		idle(1);
		temp = count.read();
	}

	/**
	 * Compares its two inputs.
	 */
	void loop() {
		clipped v = clip.read();
		bool comparison = temp == v;
		result.write(comparison);
		temp = count.read();
	}
}
