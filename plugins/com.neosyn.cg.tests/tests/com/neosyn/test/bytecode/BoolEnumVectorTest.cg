package com.neosyn.test.bytecode;

/**
 * Regression for the bool/enum comparison NPE (S162).
 *
 * A comparison whose two operands have no common IR type (a bool port checked or
 * driven with a NUMERIC 0/1 vector, a `bool == int`, or a QUALIFIED enum literal
 * `p == Phase.A`) used to reach ExpressionCompiler.compareOperands with a null
 * common type and NPE (`Type.isBool()` on null) — a raw JVM stack out of a design
 * that parsed cleanly. Fixed two ways: compareOperands treats a null common type
 * as a JVM int comparison (correct, since both operands are pushed as ints), and
 * TestGenerator coerces each vector literal to its port's type.
 *
 * Written as vector tasks so the harness SIMULATES and value-checks each output.
 */

/** A bool port driven AND checked with numeric 0/1 vectors (not true/false). */
task BoolNumericVectorPort {
	properties {
		test: {
			din:  [ 1, 0, 1, 1, 0 ],
			flag: [ 1, 0, 1, 1, 0 ]
		}
	}

	sync { in bool din; out bool flag; }

	void loop() { flag.write(din.read()); }
}

/** An enum state compared via a QUALIFIED literal; bool input on a numeric vector. */
task EnumQualifiedCompare {
	properties {
		test: {
			tick: [ 0, 0, 0, 0 ],
			code: [ 0, 1, 2, 0 ]
		}
	}

	sync { in bool tick; out u2 code; }

	enum Phase { A, B, C }

	Phase p;

	void loop() {
		tick.read();
		code.write((u2) p);                 // publish the current state
		if (p == Phase.A) { p = Phase.B; }  // qualified literal in a comparison
		else if (p == Phase.B) { p = Phase.C; }
		else { p = Phase.A; }
	}
}
