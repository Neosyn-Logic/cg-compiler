/*
 * TRAPS T105 (S183) — a CONSTANT array index must not be wrapped in to_integer().
 *
 * A local array with an initialiser lowers to element-wise stores at literal indexes, and reads at a
 * literal index lower to loads at a literal index. VhdlIrPrinter.printIndexes wrapped EVERY index in
 * `to_integer(...)`, so a constant came out as:
 *
 *     local_..._c_small(to_integer("000"))  := x"11";
 *
 * A bare string literal is ambiguous between numeric_std's `signed` and `unsigned` overloads of
 * to_integer, so GHDL — and any conforming tool — refuses to compile it:
 *
 *     error: can't resolve overload for function call, slice or indexed name
 *
 * Found running VHDL simulation on cg-ip-cores RISC-V, where it produced 150 such
 * lines across 8 files. It was in EVERY shipped release back to 2.10.0; nothing caught it because
 * the VHDL sweep skips all ten RISC-V tops as "no .tb.vhd".
 *
 * BOTH literal forms are covered on purpose, because printQuotedValue picks by width:
 *   - `small[5]`  -> 3-bit index -> binary form  "000"
 *   - `wide[16]`  -> 4-bit index -> hex form     x"0"     (4 % 4 == 0)
 * A fix that only handled the binary form would leave the hex one just as unresolvable.
 *
 * Verilog is unaffected — it emits `[3'h0]`, which is unambiguous — so this fixture is expected to
 * pass on every backend both before and after the fix EXCEPT ghdl, which cannot compile it at all
 * before the fix. That is the point: the failure is at ANALYSIS, not at a value check.
 */
package com.neosyn.test.bytecode;

network ConstArrayIndexTest {
	properties { test: { terminate: "checker.finished" } }

	checker = new task {
		bool finished;

		void setup() {
			finished = false;

			// 5 elements -> 3-bit index -> the BINARY literal form
			u8 small[5] = {0x11, 0x22, 0x33, 0x44, 0x55};
			// 16 elements -> 4-bit index -> the HEX literal form
			u8 wide[16] = {
				0xA0, 0xA1, 0xA2, 0xA3, 0xA4, 0xA5, 0xA6, 0xA7,
				0xA8, 0xA9, 0xAA, 0xAB, 0xAC, 0xAD, 0xAE, 0xAF};

			// Read back at CONSTANT indexes (10 of them): this exercises the load path as well as the
			// store path, and both went through the same broken printIndexes.
			print("small[0]=", small[0], " small[4]=", small[4]);
			print("wide[0]=", wide[0], " wide[15]=", wide[15]);

			assert(small[0] == 0x11);
			assert(small[1] == 0x22);
			assert(small[2] == 0x33);
			assert(small[3] == 0x44);
			assert(small[4] == 0x55);

			assert(wide[0] == 0xA0);
			assert(wide[1] == 0xA1);
			assert(wide[7] == 0xA7);
			assert(wide[8] == 0xA8);
			assert(wide[15] == 0xAF);

			// A variable index must keep working: that path legitimately needs to_integer,
			// and a fix that dropped the conversion everywhere would break it.
			u5 i = 0;
			u16 sum = 0;
			while (i < 5) {
				sum = (u16) (sum + small[i]);
				i = i + 1;
			}
			print("sum via variable index = ", sum);
			assert(sum == 0xFF);   // 0x11+0x22+0x33+0x44+0x55

			print("ConstArrayIndexTest: 10 constant-index checks + 1 variable-index check OK");
			finished = true;
		}
	};
}
