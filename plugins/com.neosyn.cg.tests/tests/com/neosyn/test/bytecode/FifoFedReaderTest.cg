/*
 * TRAPS T102 (S182): a task reading from a std.fifo.SynchronousFIFO deadlocked in the generated VHDL.
 *
 * The FIFO is a REGISTERED producer: it pops an element on `dout_ready && !empty` and presents it one cycle later, so the
 * reader must assert ready while it WAITS. That assertion lives in the per-state default action AddReadyAssignments adds
 * (a transition with no target state). The Verilog printer emits it as the final `else`; the VHDL ready process dropped
 * it, so the reader's ready stayed 0, the FIFO never popped, and the reader waited forever -- the UDP-IP-Stack's VHDL
 * never sent a frame. app/FIFOs.cg did not catch it: it has no terminate condition, so a VHDL run that reads nothing
 * passed as "elaborate-only".
 *
 * The reader takes one value at a time with pauses (it leaves the reading state after each read), then a burst.
 */
package com.neosyn.test.bytecode;

task FifoFedProducer {
    out stream u8 dout;
    u8 i;

    void setup() {
        for (i = 0; i < 16; i++) {
            dout.write(i);
        }
    }
}

task FifoFedReader {
    in stream u8 din;
    bool finished;
    u8 i;

    void setup() {
        finished = false;
        for (i = 0; i < 8; i++) {
            u8 v = din.read();
            print("fifo reader got ", v);
            assert(v == i);
            idle(3);
        }
        for (i = 8; i < 16; i++) {
            u8 v = din.read();
            print("fifo reader got ", v);
            assert(v == i);
        }
        print("=== FifoFedReaderTest PASSED ===");
        finished = true;
    }
}

network FifoFedReaderTest {
    properties {
        test: { terminate: "reader.finished" }
    }

    producer = new FifoFedProducer();

    fifo = new std.fifo.SynchronousFIFO({size: 32, width: 8});
    fifo.reads(producer.dout);

    reader = new FifoFedReader();
    reader.reads(fifo.dout);
}
