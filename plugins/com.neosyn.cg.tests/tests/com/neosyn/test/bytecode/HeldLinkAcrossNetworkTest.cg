/*
 * TRAPS T57 / T58 (S182): a stream link whose producer or consumer sits inside a SUB-NETWORK.
 *
 * The UDP-IP-Stack echo lost the UDP header and 23 payload bytes of every reply: UDP_Send's inline
 * task writes its NETWORK's `dout (ready)` port, UDP_Top re-exports it, and IpTop wires it to the
 * IP_Send task, which reads one byte and then stops reading for ~33 cycles. Both ends are plain
 * generated tasks, but the link crosses two network boundaries, so it was not recognised as a
 * direct held link: the consumer got the registered-producer (FIFO) handshake and the producer the
 * stall path, which overwrote every value presented while the consumer was not reading.
 *
 * HeldLinkAcrossNetworkTest: producer two networks down, consumer pauses after the first read.
 * HeldLinkIntoNetworkTest:   the mirror -- consumer inside a sub-network, producer outside.
 * HeldLinkLookaheadReadTest: MakeIPPacket's store shape, on a plain same-network link -- the read is the argument
 *                            of the second of two writes, so its availability is checked one state before its value
 *                            is used.
 */
package com.neosyn.test.bytecode;

// The UDP_Send shape: an inline task writes its enclosing network's stream output.
network HeldLinkInnerSource {
    out stream u8 dout;

    gen = new task {
        u8 i;

        void setup() {
            for (i = 0; i < 16; i++) {
                dout.write(i);
            }
        }
    };
}

// The UDP_Top shape: re-exports a sub-network's stream output.
network HeldLinkMiddleSource {
    out stream u8 dout;

    src = new HeldLinkInnerSource();
    this.reads(src.dout);
}

network HeldLinkAcrossNetworkTest {
    properties {
        test: { terminate: "check.finished" }
    }

    source = new HeldLinkMiddleSource();

    // The IP_Send shape: take one value, stop reading for a while, then drain the rest.
    check = new task {
        bool finished;
        u8 i;

        void setup() {
            finished = false;
            u8 first = source.dout.read();
            print("across got ", first);
            assert(first == 0);
            idle(10);
            for (i = 1; i < 16; i++) {
                u8 v = source.dout.read();
                print("across got ", v);
                assert(v == i);
            }
            print("=== HeldLinkAcrossNetworkTest PASSED ===");
            finished = true;
        }
    };
}

// The mirror: the consumer is an inline task inside a sub-network, reading the network's input.
network HeldLinkInnerSink {
    in stream u8 din;
    out bool done;

    check = new task {
        u8 i;

        void setup() {
            done.write(false);
            for (i = 0; i < 16; i++) {
                u8 v = din.read();
                print("into got ", v);
                assert(v == i);
                idle(3);
            }
            print("=== HeldLinkIntoNetworkTest PASSED ===");
            done.write(true);
        }
    };
}

network HeldLinkIntoNetworkTest {
    properties {
        test: { terminate: "watch.finished" }
    }

    source = new task {
        out stream u8 dout;
        u8 i;

        void setup() {
            for (i = 0; i < 16; i++) {
                dout.write(i);
            }
        }
    };

    sink = new HeldLinkInnerSink();
    sink.reads(source.dout);

    watch = new task {
        bool finished;

        void loop() {
            if (sink.done.read) {
                finished = true;
            }
        }
    };
}

network HeldLinkLookaheadReadTest {
    properties {
        test: { terminate: "check.finished" }
    }

    source = new task {
        out stream u8 dout;
        u8 i;

        void setup() {
            for (i = 0; i < 8; i++) {
                dout.write(i);
            }
        }
    };

    // MakeIPPacket's store: `packet.write(x); packet.write(body.read());`
    relay = new task {
        out push u8 o;
        u8 n;

        void setup() {
            for (n = 0; n < 8; n++) {
                o.write((u8) (0xA0 + n));
                o.write(source.dout.read());
            }
        }
    };

    // Expects A0 0 A1 1 ... A7 7.
    check = new task {
        bool finished;
        u5 c;

        void loop() {
            u8 x = relay.o.read();
            u8 e = c[0] ? (u8) (c >> 1) : (u8) (0xA0 + (c >> 1));
            print("lookahead got ", x, " expected ", e);
            assert(x == e);
            finished = c == 15;
            c++;
        }
    };
}
