package com.neosyn.test.bytecode;

/**
 * Regression for the PathIterator branch-deletion bug (S159).
 *
 * A nested `if` inside branch N of an `if / else if` chain used to make
 * PathIterator never enumerate a code path for branch N+1, so IfDeveloper never
 * developed that branch and its body vanished from the generated hardware — while
 * the FSM still transitioned into that state. The design wedged forever, in
 * simulation AND in silicon, and the compile reported success with no diagnostic.
 * Root cause: updateIterators() consumed a child that the exhaustion path then
 * discarded via PathResetException without accounting for it.
 *
 * Written as `inp`/`outp` vector tasks so the harness actually SIMULATES and
 * value-checks each output (a `terminate:`-only network would only compile — see
 * the S159 note on skipped fixtures). Each task walks a state machine one step per
 * input and emits the value written in each branch; a dropped branch shows up as a
 * wrong/missing output, not merely a hang.
 */

/** Nested `if` in branch 0 — used to drop branch 1's body (0xBB). */
task NestedIfBranch0 {
	properties {
		test: {
			inp:  [ 0, 0, 0, 0 ],
			outp: [ 170, 187, 204, 221 ]
		}
	}

	sync { in u2 inp; out u8 outp; }

	u3 state;
	bool flag = true;

	void loop() {
		inp.read();
		if (state == 0) { if (flag) { outp.write(0xAA); state = 1; } }
		else if (state == 1) { outp.write(0xBB); state = 2; }
		else if (state == 2) { outp.write(0xCC); state = 3; }
		else if (state == 3) { outp.write(0xDD); state = 0; }
	}
}

/** Nested `if` in branch 1 — used to drop branch 2's body (0xCC). */
task NestedIfBranch1 {
	properties {
		test: {
			inp:  [ 0, 0, 0, 0 ],
			outp: [ 170, 187, 204, 221 ]
		}
	}

	sync { in u2 inp; out u8 outp; }

	u3 state;
	bool flag = true;

	void loop() {
		inp.read();
		if (state == 0) { outp.write(0xAA); state = 1; }
		else if (state == 1) { if (flag) { outp.write(0xBB); state = 2; } }
		else if (state == 2) { outp.write(0xCC); state = 3; }
		else if (state == 3) { outp.write(0xDD); state = 0; }
	}
}
