/*
 * TRAPS T107 (S183) — a `push` output feeding a FIFO must produce HDL that BUILDS.
 *
 * `SynchronousFIFO.din` is a ready/valid input, so a consumer's port map spells a `din_ready`
 * companion. A `push` output has no `ready`, and the signal DECLARATION was driven by the source
 * port's interface while the port MAP was driven by the target's. The result:
 *
 *     ProtoTop.v:109     .din_ready(arpTop_dout_ready),     <- never declared
 *     ProtoTop.vhd:141   din_ready => arpTop_dout_ready,    <- "no declaration for ..."
 *
 * Verilog absorbed it as an implicit net and built anyway; VHDL refused the file. So the two back
 * ends disagreed about whether the design even compiles — which is the real defect, more than the
 * missing wire. Found while buffering the UDP core's ARP reply, where `arpTop.dout` is `push`.
 *
 * Buffering a source that cannot be back-pressured is a reasonable thing to want — it is precisely
 * what a FIFO is for — so this is supported, not rejected.
 *
 * The fixture keeps the FIFO comfortably larger than the burst (8 deep for 4 values) because a
 * `push` producer CANNOT be back-pressured: with a full FIFO the values would simply be dropped,
 * and this test is about the generated HDL building, not about overflow behaviour.
 */
package com.neosyn.test.bytecode;

network PushIntoFifoTest {
	properties { test: { terminate: "sink.finished" } }

	producer = new task {
		out u8 dout (push);
		bool done;

		void setup() {
			done = false;
		}

		void loop() {
			if (!done) {
				dout.write(0x11);
				dout.write(0x22);
				dout.write(0x33);
				dout.write(0x44);
				done = true;
			}
		}
	};

	fifo = new std.fifo.SynchronousFIFO({size: 8, width: 8});
	fifo.reads(producer.dout);

	sink = new task {
		in sync ready u8 din;
		bool finished;

		void setup() {
			finished = false;

			u8 v0 = din.read;
			u8 v1 = din.read;
			u8 v2 = din.read;
			u8 v3 = din.read;

			print("PushIntoFifo read: ", v0, " ", v1, " ", v2, " ", v3);
			assert(v0 == 0x11);
			assert(v1 == 0x22);
			assert(v2 == 0x33);
			assert(v3 == 0x44);

			print("PushIntoFifoTest: 4 values through a push -> FIFO link OK");
			finished = true;
		}
	};

	sink.reads(fifo.dout);
}
