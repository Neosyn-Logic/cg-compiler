package com.neosyn.test.bytecode;

/**
 * Value gate for SIGNED `/` and `%` by a compile-time power of two.
 *
 * Regression for the bug where the lowering was `a >> k` / `a & (n-1)`
 * unconditionally: an arithmetic shift FLOORS and a mask drops the sign, but C,
 * RISC-V DIV/REM and Verilog `/` all TRUNCATE TOWARD ZERO. Uncorrected this
 * silently produced -7/4 == -2 (should be -1) and -7%4 == 1 (should be -3), and
 * disagreed with the std.math.Divide built-in, which truncates. Every
 * non-negative operand was unaffected, which is exactly why it survived: the
 * pre-existing fixtures only ever divided non-negative values.
 *
 * These are written as `inp`/`outp` vector tasks ON PURPOSE. A network with an
 * internal checker and only `terminate:` in its `test` property is SKIPPED by
 * BytecodePassTests ("Skipping simulation (empty test arrays)") and is only
 * elaborated — not simulated — by IverilogPassTests, so it would gate nothing.
 * The harness drives `inp` and compares `outp` element by element, which is a
 * genuine value check on the Fast-Sim backend.
 *
 * Cases per operator: both signs, exact vs inexact division, |a| < divisor
 * (quotient 0, where the sign of the remainder is the only thing distinguishing
 * the two roundings), zero, and both 32-bit extremes.
 */

/** Signed division by 4 must truncate toward zero, not floor. */
task SignedDiv4 {
	properties {
		test: {
			inp:  [ 7, -7, 8, -8, 1,  -1, 0, -9, -2147483648, 2147483647 ],
			outp: [ 1, -1, 2, -2, 0,   0, 0, -2,  -536870912,  536870911 ]
		}
	}

	sync { in int<32> inp; out int<32> outp; }

	void loop() {
		outp.write(inp.read() / 4);
	}
}

/** Signed remainder by 4 must take the sign of the dividend. */
task SignedMod4 {
	properties {
		test: {
			inp:  [ 7, -7, 8, -8, 1,  -1, 0, -9, -2147483648, 2147483647 ],
			outp: [ 3, -3, 0,  0, 1,  -1, 0, -1,           0,          3 ]
		}
	}

	sync { in int<32> inp; out int<32> outp; }

	void loop() {
		outp.write(inp.read() % 4);
	}
}

/** Divisor 2 is the tightest case: -1/2 must be 0, not -1. */
task SignedDiv2 {
	properties {
		test: {
			inp:  [ 7, -7, 8, -8, 1,  -1, 0, -9, -2147483648, 2147483647 ],
			outp: [ 3, -3, 4, -4, 0,   0, 0, -4, -1073741824, 1073741823 ]
		}
	}

	sync { in int<32> inp; out int<32> outp; }

	void loop() {
		outp.write(inp.read() / 2);
	}
}

/** Remainder by 2: -1 % 2 must be -1, not 1. */
task SignedMod2 {
	properties {
		test: {
			inp:  [ 7, -7, 8, -8, 1,  -1, 0, -9, -2147483648, 2147483647 ],
			outp: [ 1, -1, 0,  0, 1,  -1, 0, -1,           0,          1 ]
		}
	}

	sync { in int<32> inp; out int<32> outp; }

	void loop() {
		outp.write(inp.read() % 2);
	}
}

/** Divide by 1 (shift by 0) must be the identity for negatives too. */
task SignedDiv1 {
	properties {
		test: {
			inp:  [ 7, -7, 0, -9, -2147483648, 2147483647 ],
			outp: [ 7, -7, 0, -9, -2147483648, 2147483647 ]
		}
	}

	sync { in int<32> inp; out int<32> outp; }

	void loop() {
		outp.write(inp.read() / 1);
	}
}

/**
 * The UNSIGNED path must keep the cheaper uncorrected shift/mask lowering and
 * stay exact — the fix is gated on signedness and must not touch this.
 * Values are the unsigned readings of the signed vectors above.
 */
task UnsignedDiv4 {
	properties {
		test: {
			inp:  [ 7, 4294967289, 8, 4294967288, 1, 4294967295, 0, 4294967287, 2147483648, 2147483647 ],
			outp: [ 1, 1073741822, 2, 1073741822, 0, 1073741823, 0, 1073741821,  536870912,  536870911 ]
		}
	}

	sync { in u32 inp; out u32 outp; }

	void loop() {
		outp.write(inp.read() / 4);
	}
}

/** Unsigned remainder keeps the plain mask. */
task UnsignedMod4 {
	properties {
		test: {
			inp:  [ 7, 4294967289, 8, 4294967288, 1, 4294967295, 0, 4294967287, 2147483648, 2147483647 ],
			outp: [ 3,          1, 0,          0, 1,          3, 0,          3,          0,          3 ]
		}
	}

	sync { in u32 inp; out u32 outp; }

	void loop() {
		outp.write(inp.read() % 4);
	}
}
