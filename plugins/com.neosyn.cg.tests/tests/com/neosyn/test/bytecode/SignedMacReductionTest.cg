package com.neosyn.test.bytecode;

/**
 * Elaboration gate for an INLINE SIGNED MAC reduction over a sync-ready
 * handshake: {@code acc += a * b} each cycle, emit the dot product once per
 * group of 4. The signed 32x32 product sign-extends the two buffered stream
 * inputs. That sign-extension used to emit invalid Verilog —
 * {@code (valid ? internal : port)[31]}, a bit-select of a parenthesized
 * ternary, which iverilog AND yosys both reject — so `generate` reported
 * "Success" while the RTL would not elaborate. The Verilog printer now
 * distributes trunc/sext into a ternary operand's arms
 * ({@code sext(c ? a : b)} → {@code (c ? sext(a) : sext(b))}), so this must
 * elaborate. Values: g0 = 2*1 - 3*2 + 4*3 + 5*-1 = 3 ; g1 = -10*4 = -40.
 */
network SignedMacReductionTest {

	properties {
		test: { terminate: "checker.finished" }
	}

	source = new task {
		out sync ready int<32> a;
		out sync ready int<32> b;
		u8 i;
		const int<32> A[8] = { 2, -3, 4, 5, -10, -10, -10, -10 };
		const int<32> B[8] = { 1,  2, 3, -1,  1,   1,   1,   1 };
		void setup() {
			for (i = 0; i < 8; i++) {
				a.write(A[i]);
				b.write(B[i]);
			}
		}
	};

	dut = new task {
		in sync ready int<32> a;
		in sync ready int<32> b;
		out sync ready int<64> p;
		int<32> cnt = 0;
		int<64> acc = 0;
		void loop() {
			acc = acc + a.read() * b.read();
			if (cnt == 3) { p.write(acc); cnt = 0; acc = 0; }
			else { cnt = cnt + 1; }
		}
	};
	dut.reads(source.a, source.b);

	checker = new task {
		in sync ready int<64> p;
		bool finished;
		u8 i;
		const int<64> P[2] = { 3, -40 };
		void setup() {
			for (i = 0; i < 2; i++) {
				int<64> v = p.read();
				assert(v == P[i]);
			}
			print("signed MAC reduction 2/2 OK\n");
			finished = true;
		}
	};
	checker.reads(dut.p);
}
