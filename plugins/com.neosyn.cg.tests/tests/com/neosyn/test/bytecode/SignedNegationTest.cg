package com.neosyn.test.bytecode;

/**
 * Value gate for NEGATING an unsigned operand.
 *
 * The language rule is `-e : signed<N + 1>`. The Verilog backend has no bit-accurate unary
 * negate, so it rewrites `-x` as `0 - x` -- and that rewrite used to lose the type. The
 * additive rule is `unify(T1, T2)` plus a bit, and unify of two UNSIGNED operands is
 * unsigned, so negating a `u8` produced an UNSIGNED difference that is negative whenever the
 * operand is positive.
 *
 * The damage showed up one level out, as a zero-extension into the wider signed context:
 *
 *     reg [8 : 0] orion;                                     // unsigned
 *     orion = (9'h0 - {1'b0, a});                            // 9'h1FF, i.e. -1
 *     lyra  = ($signed({1'b0, orion}) + $signed({2'b0, b})); // ZERO-extends -> 511
 *
 * 511 + 3 = 514, which as signed 10-bit is -510. The bytecode simulator returned 2. Both
 * backends reported success; only the netlist was wrong, which is the direction that matters
 * least in simulation and most in silicon.
 *
 * Found in the shipped Sobel core, where both gradients mixed `u8` pixels into a signed
 * accumulator, so the HDL computed a different gradient than the simulator on every edge.
 *
 * Vectors deliberately straddle zero: a positive result, a NEGATIVE result (the case that
 * only fails when the extension is wrong), and a case where the negated operand is the
 * larger one. Reverting the fix makes vector 0 read 0x7e02 under iverilog.
 */
task SignedNegationTest {
	properties {
		test: {
			a: [ 1,  5, 2,  0, 255,   7 ],
			b: [ 3,  1, 9,  4,   1, 255 ],
			y: [ 2, -4, 7,  4, -254, 248 ]
		}
	}

	sync { in u8 a; in u8 b; out i15 y; }

	void loop() {
		y.write((i15) (-a.read() + b.read()));
	}
}

/**
 * The same defect reached through a signed operand, to pin that the fix did not simply
 * hard-code unsigned inputs: negating an `i8` must still widen to `signed<9>` and
 * sign-extend. INT_MIN is included because its negation does not fit the operand width and
 * is the value a too-narrow result type silently wraps.
 */
task SignedNegationOfSignedTest {
	properties {
		test: {
			a: [  1, -1,  127, -128,   0 ],
			y: [ -1,  1, -127,  128,   0 ]
		}
	}

	sync { in int<8> a; out int<9> y; }

	void loop() {
		y.write((int<9>) (-a.read()));
	}
}
