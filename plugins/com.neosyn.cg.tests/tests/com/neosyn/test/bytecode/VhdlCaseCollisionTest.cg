package com.neosyn.test.bytecode;

/**
 * Names that differ only in CASE must still generate analysable VHDL.
 *
 * C⏚ is case-sensitive; VHDL is not. SCREAMING_CASE constants beside lower_case state is the
 * most ordinary naming convention there is, and it used to emit VHDL that would not analyse:
 *
 *     error: identifier "checks" already used for a declaration
 *     error: previous declaration: constant "CHECKS"
 *
 * while `generate` reported "Success!" regardless — so nothing surfaced until a VHDL tool ran,
 * and only for users targeting VHDL. One core hit it three times in a single file.
 *
 * Every member of a colliding group is now emitted as a VHDL extended identifier (`\CHECKS\`,
 * `\checks\`), which is case-sensitive AND never equal to a basic identifier.
 *
 * The values matter as much as the analysis: escaping must not change what the design
 * computes, and the constant must still be readable under its escaped name. Reverting the fix
 * makes this fixture fail to ANALYSE under ghdl rather than fail a vector, which is why the
 * VHDL gate is the one that guards it.
 */
task VhdlCaseCollisionTest {
	properties {
		test: {
			x: [ 1, 2, 3, 4 ],
			y: [ 1, 3, 6, 10 ]
		}
	}

	const int CHECKS = 3;

	sync { in u8 x; out u16 y; }

	u16 checks = 0;

	void loop() {
		checks = (u16) (checks + x.read());
		y.write(checks);
	}
}

/**
 * The same clash between a PORT and a state variable, and a third spelling, to pin that the
 * grouping is by lower-cased name rather than by declaration kind.
 */
task VhdlCaseCollisionPortTest {
	properties {
		test: {
			Data: [ 5, 6 ],
			out_v: [ 8, 9 ]
		}
	}

	sync { in u8 Data; out u16 out_v; }

	u16 data = 0;
	const int DATA = 3;

	void loop() {
		data = (u16) (Data.read() + DATA);
		out_v.write(data);
	}
}
