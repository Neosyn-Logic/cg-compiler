package com.neosyn.test.pass;

/*
 * FILE-SCOPE DECLARATIONS.
 *
 * `const`, `typedef`, `struct` and `enum` written straight after `package`, with no
 * enclosing `bundle`. They parse into an implicit bundle (grammar rule ImplicitBundle,
 * named <File>_pkg during instantiation) and are in scope UNQUALIFIED for everything in
 * the file -- which is the whole point, since a declaration written at file scope is
 * meant to be used as `SCALE`, not `Something.SCALE`.
 *
 * Before this, a `const` after `package` was a syntax error ("missing EOF at 'const'"):
 * the single most common first-contact mistake in the language, because it is what every
 * C-like language accepts.
 *
 * Enum LITERALS still need qualifying (`Mode.RUN`). That is not a limitation of file
 * scope -- a named bundle behaves identically, even through an explicit wildcard import --
 * so the two forms agree, which is the property worth locking in.
 */

const int SCALE = 3;

typedef u12 word_t;

struct Pt { u8 x; u8 y; }

enum Mode { IDLE, RUN }

const int<32> triple(int<32> x) { return x * SCALE; }

// Uses all five: the const (through the function), the typedef on a port, the struct as
// a local, and the enum as a state variable.
task FileScopeUser {
	properties {
		test: { a: [ 1, 2, 3, 4 ], y: [ 3, 6, 9, 12 ], mode: [ 1, 1, 1, 1 ] }
	}

	in sync word_t a; out sync int<32> y, sync u2 mode;

	Mode m;

	void loop() {
		Pt p;
		p.x = (u8) a.read();
		y.write(triple((int<32>) p.x));
		if (m == Mode.IDLE) {
			m = Mode.RUN;
		}
		mode.write((u2) m);
	}
}
