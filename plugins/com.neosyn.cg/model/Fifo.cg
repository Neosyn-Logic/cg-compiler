 *
 * C⏚ Standard Library - FIFO Primitives (std.fifo)
 *
 * This file defines built-in FIFO (First-In-First-Out) queue primitives for
 * buffered communication between hardware blocks.
 *
 * Available FIFO types:
 * - SynchronousFIFO: Single-clock FIFO using PseudoDualPortRAM
 * - AsynchronousFIFO: Dual-clock FIFO for clock domain crossing (CDC)
 *
 * Parameters:
 * - size: FIFO depth (number of entries)
 * - width: Bit width of each entry
 *
 * Ports use stream (valid/ready) handshaking for flow control.
 ******************************************************************************/

package std.fifo;

task SynchronousFIFO {

	properties {
		implementation: {
			type: "builtin",
			dependencies: ["std.mem.PseudoDualPortRAM"]
		}
	}

	const int size, width, depth = sizeof(size - 1);

	stream {
		in unsigned<width> din;
		out unsigned<width> dout;
	}

	// High while fewer than 3 more values can be accepted on `din`. A producer that stops
	// writing when it rises never has to wait with a value in flight -- e.g. one fed by a
	// RAM, whose read data would move on while it waited (TRAPS T145).
	out bool almost_full;
}

task AsynchronousFIFO {

	properties {
		clocks: ["din_clock", "dout_clock"],
		implementation: {
			type: "builtin",
			// Both languages' helpers: Verilog uses the FIFO_Flag_* pair and DualPortRAM, VHDL
			// FIFO_Pointer_Sync and PseudoDualPortRAM. Each generator copies the files that exist in
			// its own library and skips the rest. Keep builtin-ir/std/fifo/AsynchronousFIFO.ir in
			// step: generate reads THAT list (TRAPS T133).
			dependencies: [
				"com.neosyn.fifo.FIFO_Flag_Async",
				"com.neosyn.fifo.FIFO_Flag_Controller",
				"com.neosyn.fifo.FIFO_Pointer_Sync",
				"com.neosyn.fifo.FIFO_Read_Controller",
				"com.neosyn.fifo.FIFO_Write_Controller",
				"std.mem.DualPortRAM",
				"std.mem.PseudoDualPortRAM"
			]
		},
		domains: {
			din_clock:  ["din", "din_rdy"],
			dout_clock: ["readFifo", "dout", "readFifo_rdy"]
		}
	}

	const int size, width, depth = sizeof(size - 1);

	stream {
		in unsigned<width> din;
		out unsigned<width> dout;
	}
}
