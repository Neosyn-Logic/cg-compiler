<?xml version="1.0" encoding="UTF-8"?>
<com.neosyn.models.dpn:Actor xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:com.neosyn.models.dpn="http://www.neosyn.io/2013/Dpn"
    xmlns:com.neosyn.models.ir="http://www.neosyn.io/2013/Ir"
    name="std.fifo.AsynchronousFIFO" properties="{&quot;resets&quot;:[{&quot;type&quot;:&quot;asynchronous&quot;,&quot;active&quot;:&quot;low&quot;,&quot;name&quot;:&quot;reset_n&quot;}],&quot;clocks&quot;:[&quot;din_clock&quot;,&quot;dout_clock&quot;],&quot;implementation&quot;:{&quot;type&quot;:&quot;builtin&quot;,&quot;dependencies&quot;:[&quot;com.neosyn.fifo.FIFO_Flag_Async&quot;,&quot;com.neosyn.fifo.FIFO_Flag_Controller&quot;,&quot;com.neosyn.fifo.FIFO_Pointer_Sync&quot;,&quot;com.neosyn.fifo.FIFO_Read_Controller&quot;,&quot;com.neosyn.fifo.FIFO_Write_Controller&quot;,&quot;std.mem.DualPortRAM&quot;,&quot;std.mem.PseudoDualPortRAM&quot;]}}">
  <inputs name="din" interface="SYNC_READY">
    <type xsi:type="com.neosyn.models.ir:TypeInt" size="32"/>
    <additionalInputs name="din_valid">
      <type xsi:type="com.neosyn.models.ir:TypeBool"/>
    </additionalInputs>
    <additionalOutputs assignable="true" name="din_ready">
      <type xsi:type="com.neosyn.models.ir:TypeBool"/>
    </additionalOutputs>
  </inputs>
  <outputs name="dout" interface="SYNC_READY">
    <type xsi:type="com.neosyn.models.ir:TypeInt" size="32"/>
    <additionalOutputs assignable="true" name="dout_valid">
      <type xsi:type="com.neosyn.models.ir:TypeBool"/>
    </additionalOutputs>
    <additionalInputs name="dout_ready">
      <type xsi:type="com.neosyn.models.ir:TypeBool"/>
    </additionalInputs>
  </outputs>
</com.neosyn.models.dpn:Actor>
